{
  "name": "omp-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "package:linux": "NO_STRIP=true tauri build --bundles appimage,deb,rpm",
    "package:windows": "tauri build --bundles nsis,msi",
    "package:macos": "tauri build --bundles dmg,app",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:frontend": "node scripts/frontend-smoke.mjs",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "verify": "npm run build && npm run test:frontend && npm run test:e2e && npm run test:rust",
    "benchmark": "node scripts/performance.mjs",
    "benchmark:runtime": "node scripts/runtime-performance.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@solidjs/router": "^0.16.2",
    "@tanstack/solid-virtual": "^3.13.34",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "lucide-solid": "^1.25.0",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-solid": "^2.11.12"
  }
}
